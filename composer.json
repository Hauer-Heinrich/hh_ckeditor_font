{
    "type": "typo3-cms-extension",
    "name": "hauerheinrich/hh-ckeditor-font",
    "description": "CKEditor 5 Font buttons for TYPO3 v13: class-based font color, font background color and font family pickers, fully configurable via RTE YAML.",
    "keywords": ["TYPO3 CMS", "TYPO3", "extension", "ckeditor"],
    "homepage": "https://www.hauer-heinrich.de",
    "license": "GPL-2.0-or-later",
    "authors": [
        {
            "name": "Christian Hackl",
            "homepage": "https://www.hauer-heinrich.de",
            "role": "Developer"
        },
        {
            "name": "Martin Hofmann",
            "homepage": "https://www.hauer-heinrich.de",
            "role": "Developer"
        }
    ],
    "support": {
        "issues": "https://github.com/Hauer-Heinrich/hh_ckeditor_font/issues",
        "source": "https://github.com/Hauer-Heinrich/hh_ckeditor_font",
        "docs": "https://github.com/Hauer-Heinrich/hh_ckeditor_font/blob/master/README.md"
    },
    "funding": [
        {
            "type": "paypal",
            "url": "https://www.paypal.com/paypalme/hauerheinrich"
        }
    ],
    "require": {
        "typo3/cms-core": "^13.4",
        "typo3/cms-rte-ckeditor": "^13.4"
    },
    "extra": {
        "typo3/cms": {
            "cms-package-dir": "{$vendor-dir}/typo3/cms",
            "web-dir": ".Build/Web",
            "extension-key": "hh_ckeditor_font",
            "version": "2.1.0",
            "Package": {
                "providesPackages": {}
            }
        }
    },
    "archive": {
        "exclude": [
            "/.git/",
            "/.github/",
            "/.idea/",
            "/.editorconfig",
            "/.gitattributes",
            "/.gitignore",
            "/.bundle.config.json",
            "/.bundle.config.json.example",
            "/.bundle.mjs",
            "/package.json",
            "/package-lock.json",
            "/*.code-workspace",
            "**/node_modules/",
            "**/*.zip"
        ]
    }
}
